# ──────────────────────────────────────────────────
# HGI Prospecting System — Environment Variables
# Copy this file to .env and fill in the values
# ──────────────────────────────────────────────────

# ── Database ──────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://hgi:hgi_password@postgres:5432/hgi_db
DATABASE_URL_SYNC=postgresql://hgi:hgi_password@postgres:5432/hgi_db

# ── Redis / Celery ────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── JWT Auth ──────────────────────────────────────
JWT_SECRET=change-me-in-production-minimum-32-characters-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── Ollama / Mistral ──────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=mistral

# ── Google OAuth 2.0 ──────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/google/callback
# Encryption key for storing Google tokens (32-byte hex string)
TOKEN_ENCRYPTION_KEY=change-me-32-byte-hex-key-here-00

# ── Twilio ────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15145550000

# ── App ───────────────────────────────────────────
APP_ENV=development
APP_NAME=HGI Radar
CORS_ORIGINS=http://localhost:3000
DEFAULT_LANGUAGE=fr
LOG_LEVEL=INFO

# ── Scraping ──────────────────────────────────────
PLAYWRIGHT_HEADLESS=true
SCRAPER_PROXY_URL=
# LinkedIn session cookie (paste li_at value from browser devtools)
LINKEDIN_LI_AT_COOKIE=

# ── PostgreSQL (for docker-compose) ───────────────
POSTGRES_DB=hgi_db
POSTGRES_USER=hgi
POSTGRES_PASSWORD=hgi_password

# ── Frontend ──────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
